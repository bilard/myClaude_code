# Canva Connect API Configuration
CANVA_CLIENT_ID=your_canva_client_id
CANVA_CLIENT_SECRET=your_canva_client_secret
CANVA_REDIRECT_URI=https://votre-domaine.com/api/auth/canva/callback

# Application Configuration
APP_URL=https://votre-domaine.com
API_URL=https://votre-domaine.com
JWT_SECRET=CHANGEZ_MOI_une_clé_secrète_longue_et_aléatoire
SESSION_SECRET=CHANGEZ_MOI_une_autre_clé_secrète

# Database
DATABASE_URL=file:./dev.db

# Magento Integration (optional)
